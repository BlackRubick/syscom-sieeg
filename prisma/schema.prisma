generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  buyer
  approver
  viewer
  seller
}

enum QuoteStatus {
  open
  converted
  cancelled
}

enum UserStatus {
  active
  inactive
  pending
}

enum OrderStatus {
  pending
  approved
  rejected
  cancelled
  processing
  shipped
  delivered
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  // Número de cliente consecutivo (se muestra como CL-0001); se asigna al crear el usuario
  clientNumber  Int?           @unique @map("client_number")
  password      String
  role          UserRole       @default(buyer)
  status        UserStatus     @default(active)
  createdAt     String         @map("created_at")
  lastLogin     String?        @map("last_login")
  avatar        String?
  orders        Order[]        @relation("OrderClient")
  sellerOrders  Order[]        @relation("OrderSeller")
  quotes        Quote[]        @relation("QuoteClient")
  sellerQuotes  Quote[]        @relation("QuoteSeller")
  notifications Notification[]

  // Datos fiscales
  fiscalCompleted    Boolean @default(false) @map("fiscal_completed")
  fiscalRfc          String? @map("fiscal_rfc")
  fiscalRazonSocial  String? @map("fiscal_razon_social")
  fiscalCodpos       String? @map("fiscal_codpos")
  fiscalEmail        String? @map("fiscal_email")
  fiscalUsocfdi      String? @map("fiscal_uso_cfdi")
  fiscalRegimen      String? @map("fiscal_regimen")
  fiscalPais         String? @map("fiscal_pais")
  fiscalCalle        String? @map("fiscal_calle")
  fiscalNumExt       String? @map("fiscal_num_exterior")
  fiscalNumInt       String? @map("fiscal_num_interior")
  fiscalColonia      String? @map("fiscal_colonia")
  fiscalCiudad       String? @map("fiscal_ciudad")
  fiscalDelegacion   String? @map("fiscal_delegacion")
  fiscalLocalidad    String? @map("fiscal_localidad")
  fiscalEstado       String? @map("fiscal_estado")
  fiscalNumregidtrib String? @map("fiscal_num_reg_id_trib")
  fiscalNombre       String? @map("fiscal_nombre")
  fiscalApellidos    String? @map("fiscal_apellidos")
  fiscalTelefono     String? @map("fiscal_telefono")
  facturaUid         String? @map("factura_uid")
  discountPct        Float   @default(0) @map("discount_pct")
  cartItems          Json?   @map("cart_items")

  @@map("users")
}

model Order {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  user           User        @relation("OrderClient", fields: [userId], references: [id], onDelete: Cascade)
  // Vendedor (o admin) que levantó el pedido a nombre del cliente; null = lo hizo el propio cliente
  sellerId       String?     @map("seller_id")
  seller         User?       @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  // Cotización de la que salió el pedido (COT-0001)
  quoteNumber    Int?        @map("quote_number")
  status         OrderStatus @default(pending)
  items          Json
  total          Float
  // Cargo de envío cobrado al cliente (IVA incluido, ya sumado en total); 0 = envío sin costo
  shippingFee    Float       @default(0) @map("shipping_fee")
  priority       String      @default("normal")
  notes          String?
  syscomFolio    String?     @map("syscom_folio")
  syscomData     Json?       @map("syscom_data")
  // Último estado consultado en SYSCOM (facturación / entrega) y cuándo se consultó
  syscomTracking Json?       @map("syscom_tracking")
  syscomStatusAt DateTime?   @map("syscom_status_at")
  cfdiUid        String?     @map("cfdi_uid")
  auditLog       Json?       @map("audit_log")
  paymentId      String?     @map("payment_id")
  paymentStatus  String      @default("unpaid") @map("payment_status")
  paymentMethod  String?     @map("payment_method")
  paymentData    Json?       @map("payment_data")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

// Cotización (pedido previo). Guarda productos y cantidades; el precio siempre se recalcula al del día.
model Quote {
  id        String      @id @default(cuid())
  // Folio consecutivo (se muestra como COT-0001)
  number    Int         @unique
  userId    String      @map("user_id")
  user      User        @relation("QuoteClient", fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String?     @map("seller_id")
  seller    User?       @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  items     Json
  // Total (IVA incl.) al momento de guardarla; solo de referencia
  total     Float
  notes     String?     @db.Text
  status    QuoteStatus @default(open)
  orderId   String?     @map("order_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([sellerId])
  @@map("quotes")
}

model SiteConfig {
  id              Int   @id @default(1)
  markupPct       Float @default(0) @map("markup_pct")
  // Compras menores a freeShippingMin + IVA pagan shippingFee (IVA incl.); a SYSCOM se pide igual
  freeShippingMin Float @default(1000) @map("free_shipping_min")
  shippingFee     Float @default(200) @map("shipping_fee")

  @@map("site_config")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  orderId   String?  @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
